{
  "name": "muse-agent-cli",
  "version": "0.1.1",
  "description": "Unofficial CLI for driving your Muse personal AI agent from any terminal or agent runtime (Claude Code, Hermes, Codex).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.3"
  },
  "bin": {
    "muse": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "dependencies": {
    "muse-agent-bridge": "^0.1.1",
    "muse-agent-core": "^0.1.1"
  },
  "keywords": [
    "muse",
    "muse-cli",
    "cli",
    "agents"
  ],
  "scripts": {
    "build": "tsc -b && chmod +x dist/cli.js"
  }
}
